# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Passwords must be URL-encoded here -- spaces become %20, @ becomes %40,
# # becomes %23. A raw @ or # in a password is the most common cause of
# "can't reach database server" / P1001. Never commit real values.
#
# prisma/schema.prisma reads BOTH of these (see the `datasource db` block):
#
#   DATABASE_URL  the app's connection. On Supabase use the TRANSACTION POOLER
#                 (Project Settings > Database > Connection pooling, mode
#                 "Transaction", port 6543).  Serverless runtimes need this one.
#
#   DIRECT_URL    used only by `prisma migrate` / `prisma db push`, which open
#                 sessions and prepared statements the transaction pooler
#                 rejects. On Supabase use the SESSION pooler or the direct
#                 connection (port 5432).
#
# On a plain local Postgres, both are normally the same value.
# If DIRECT_URL is missing, `npx prisma migrate` fails with:
#   P1012: Environment variable not found: DIRECT_URL.
#
# Supabase example (replace your-project-ref and the password):
#   DATABASE_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?schema=public"
#   DIRECT_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?schema=public"

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hms?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/hms?schema=public"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# NEXTAUTH_URL must be the exact URL the app is served from, with no trailing
# slash. Locally that is http://localhost:3000; in production it is your
# deployed domain (e.g. https://hms.vercel.app).
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed safety. `npm run seed` contains one destructive step: removing the old
# placeholder rooms 101/102 created by an earlier version of the seed. By default
# it deletes nothing that a guest touched -- if those rooms carry reservations,
# folios, orders or payments, the seed skips the cleanup and reports what it
# found instead of deleting it.
#
# Set this to true only when you are certain that activity is disposable test
# data. Never set it on a database that holds real bookings:
#   SEED_ALLOW_DESTRUCTIVE_CLEANUP="true"
