# ---------------------------------------------------------------------------
# Database — PostgreSQL on Supabase
# ---------------------------------------------------------------------------
# Supabase gives you two different connection strings. Both are required, and
# they are NOT interchangeable:
#
#   DATABASE_URL  -> the app's connection. Point it at the TRANSACTION POOLER
#                    (Supabase dashboard > Project Settings > Database >
#                    Connection pooling, mode "Transaction", port 6543).
#                    Serverless/edge runtimes need this one.
#
#   DIRECT_URL    -> used only by `prisma migrate` / `prisma db push`, which
#                    open sessions and prepared statements the transaction
#                    pooler rejects. Point it at the SESSION POOLER or the
#                    direct connection (port 5432).
#
# prisma/schema.prisma reads both (see the `datasource db` block).
#
# Password must be URL-encoded if it contains special characters
# (e.g. @ -> %40, # -> %23, space -> %20).

DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?schema=public"
DIRECT_URL="postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?schema=public"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# NEXTAUTH_URL must be the exact URL the app is served from, with no trailing
# slash. Locally that is http://localhost:3000; in production it is your
# deployed domain (e.g. https://hms.vercel.app).
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
