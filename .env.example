# PostgreSQL connection string
# NOTE: passwords must be URL-encoded (spaces become %20). Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hms?schema=public"

# Required by prisma/schema.prisma (datasource.directUrl). For a local Postgres
# this is normally the same value as DATABASE_URL. On pooled providers
# (Supabase/Neon) this is the direct, non-pooled connection string.
# Without it, `npx prisma migrate` fails with:
#   P1012: Environment variable not found: DIRECT_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/hms?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
